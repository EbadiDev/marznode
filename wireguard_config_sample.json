{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "v2ray_api": {
      "listen": "127.0.0.1:8080",
      "stats": {
        "enabled": true,
        "users": []
      }
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "google",
        "address": "8.8.8.8"
      }
    ]
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "direct-in",
      "listen": "::",
      "listen_port": 9999
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "dns",
      "tag": "dns-out"
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": "dns",
        "outbound": "dns-out"
      }
    ],
    "auto_detect_interface": true
  },
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "wg-ep",
      "name": "wg0",
      "mtu": 1408,
      "address": ["20.0.0.1/24"],
      "private_key": "YOUR_SERVER_PRIVATE_KEY_HERE",
      "listen_port": 51820,
      "peers": []
    }
  ]
} 